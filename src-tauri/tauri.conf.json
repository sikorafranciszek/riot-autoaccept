{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Riot Auto Accept",
  "version": "1.0.0",
  "identifier": "pl.sikora.riotautoaccept",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Riot Auto Accept",
        "width": 340,
        "height": 500,
        "minWidth": 340,
        "minHeight": 500,
        "maxWidth": 340,
        "maxHeight": 500,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": true,
        "backgroundColor": "#0a0a0f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "category": "Utility",
    "shortDescription": "Auto-accept for League of Legends and TFT",
    "longDescription": "Automatic ready-check acceptance for League of Legends and Teamfight Tactics matches. Lightweight Tauri-based replacement for clunky Electron auto-accept tools."
  },
  "plugins": {}
}
